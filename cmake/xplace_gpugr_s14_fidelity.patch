+// For N / S / FN / FS this reproduces the old expressions exactly.
+// NOTE: ctype->originX/originY are not themselves rotated, so a rotated macro with a
+// non-zero LEF ORIGIN is still approximate.
+std::tuple<int, int, int, int> GRDatabase::getOrientedShape(
+    int orient, int cellW, int cellH, int lx, int ly, int hx, int hy) {
+    auto [olx, oly, ohx, ohy] = getOrientOffset(orient, lx, ly, hx, hy);
+    int nx = 0, ny = 0;
+    switch (orient) {
+        case 1: nx = cellH; break;                  // W
+        case 2: nx = cellW; ny = cellH; break;      // S
+        case 3: ny = cellW; break;                  // E
+        case 4: nx = cellW; break;                  // FN
+        case 6: ny = cellH; break;                  // FS
+        case 7: nx = cellH; ny = cellW; break;      // FE
+        default: break;                             // N (0), FW (5), NONE
+    }
+    return {olx + nx, oly + ny, ohx + nx, ohy + ny};
+}
