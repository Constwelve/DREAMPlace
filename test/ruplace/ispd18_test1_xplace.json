{
  "_note": "ISPD18 example: pins the ISPD18-calibrated GR settings explicitly, because the params.json ruplace_* defaults now ship the s14 congestion preset.",
  "lef_input": [
    "../Xplace/data/ispd18_test1.input.lef"
  ],
  "def_input": "../Xplace/data/ispd18_test1.input.def",
  "gpu": 1,
  "num_bins_x": 512,
  "num_bins_y": 512,
  "global_place_stages": [
    {
      "num_bins_x": 512,
      "num_bins_y": 512,
      "iteration": 200,
      "learning_rate": 0.01,
      "wirelength": "weighted_average",
      "optimizer": "nesterov"
    }
  ],
  "target_density": 1.0,
  "density_weight": 8e-05,
  "gamma": 4.0,
  "random_seed": 1000,
  "ignore_net_degree": 100,
  "enable_fillers": 1,
  "gp_noise_ratio": 0.025,
  "global_place_flag": 1,
  "legalize_flag": 0,
  "detailed_place_flag": 0,
  "stop_overflow": 0.15,
  "dtype": "float32",
  "plot_flag": 0,
  "random_center_init_flag": 1,
  "sort_nets_by_degree": 0,
  "num_threads": 8,
  "deterministic_flag": 0,
  "routability_opt_flag": 1,
  "ruplace_flag": 1,
  "ruplace_xplace_root": "../Xplace",
  "ruplace_router_backend": "xplace",
  "ruplace_gr_rrr_iters": 1,
  "ruplace_inflate_start_overflow": 0.2,
  "ruplace_admm_start_overflow": 0.2,
  "ruplace_admm_route_freq": 20,
  "ruplace_gr_grid": "bins",
  "ruplace_gr_util_mode": "legacy",
  "ruplace_gr_via_usage_scale": 1.5,
  "ruplace_gr_m1_routable": 1,
  "ruplace_gr_max_route_len_per_pin": 130,
  "ruplace_gr_wire_cost_sat": 0,
  "ruplace_write_guides": 1,
  "ruplace_external_route_eval": 1,
  "ruplace_inflate_util_threshold": 1.0,
  "ruplace_global_inflate_gamma": 0.35,
  "ruplace_global_cluster_mode": "mean",
  "ruplace_global_util_exponent": 1.0,
  "ruplace_local_inflate_gamma": 0.15,
  "ruplace_local_inflate_max_rounds": 0,
  "ruplace_inflate_area_cap": 0.01,
  "ruplace_hv_inflate_gamma": 0.0,
  "ruplace_allow_shrink": 0,
  "ruplace_admm_apply_freq": 1,
  "ruplace_admm_weight": 0.5
}
